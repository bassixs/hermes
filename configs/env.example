# Copy to .env on the server and fill real values.

# Google Sheets / Drive
GOOGLE_APPLICATION_CREDENTIALS=/home/hermes/.config/hermes/google-service-account.json
GOOGLE_SPREADSHEET_ID=
GOOGLE_QUEUE_SHEET=Queue
GOOGLE_RESULTS_SHEET=Results
GOOGLE_SIMPLE_RESULTS_SHEET=Results
GOOGLE_DRIVE_SCREENSHOT_FOLDER_ID=

# Runtime paths
HERMES_AUTOMATION_HOME=/home/hermes/hermes-automation
SCREENSHOT_DIR=/home/hermes/hermes-automation/screenshots
LOG_DIR=/home/hermes/hermes-automation/logs

# Browser capture
CAPTURE_HEADLESS=true
CAPTURE_TIMEOUT_MS=45000

# Notifications
TELEGRAM_OPERATOR_CHAT_ID=

# Table Agent Telegram bot
TELEGRAM_TABLE_BOT_TOKEN=
TELEGRAM_TABLE_ALLOWED_CHAT_IDS=
TELEGRAM_TABLE_POLL_TIMEOUT=30
